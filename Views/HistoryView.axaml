<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyAvaloniaApp.ViewModels"
             x:Class="MyAvaloniaApp.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <Grid RowDefinitions="Auto, *" Margin="20">
        
        <!-- ================= SECCIÓN SUPERIOR: Panel de Métricas / Ingresos ================= -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="Panel de Caja e Ingresos" FontWeight="Bold" FontSize="20"/>
            
            <Grid ColumnDefinitions="*, *, *" Margin="0,10,0,0">
                
                <!-- Tarjeta 1: Ingresos Totales -->
                <Border Grid.Column="0" Background="#E8F5E9" Padding="15" CornerRadius="8" Margin="0,0,10,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Ingresos Totales" Foreground="#2E7D32" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalRevenue, StringFormat='${0}'}" FontSize="22" FontWeight="Bold" Foreground="#1B5E20"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 2: Total de Ventas -->
                <Border Grid.Column="1" Background="#E3F2FD" Padding="15" CornerRadius="8" Margin="5,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Transacciones" Foreground="#1565C0" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalTransactions}" FontSize="22" FontWeight="Bold" Foreground="#0D47A1"/>
                    </StackPanel>
                </Border>

                <!-- Tarjeta 3: Ticket Promedio -->
                <Border Grid.Column="2" Background="#FFF3E0" Padding="15" CornerRadius="8" Margin="10,0,0,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Ticket Promedio" Foreground="#EF6C00" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AverageTicket, StringFormat='${0}'}" FontSize="22" FontWeight="Bold" Foreground="#E65100"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ================= SECCIÓN INFERIOR: Listado Detallado de Historial ================= -->
        <StackPanel Grid.Row="1" Spacing="10">
            <TextBlock Text="Historial de Tickets Emitidos" FontWeight="Bold" FontSize="16"/>
            
            <ListBox ItemsSource="{Binding SalesHistory}" Height="380">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,5" Background="White">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                
                                <!-- ID y Fecha -->
                                <StackPanel Grid.Column="0" Width="150" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id, StringFormat='Venta #{0}'}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>

                                <!-- Resumen de ítems comprados -->
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}" VerticalAlignment="Center" Margin="15,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Foreground="#333">
                                                <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <Run Text=" (x"/>
                                                <Run Text="{Binding Quantity}"/>
                                                <Run Text=") - $"/>
                                                <Run Text="{Binding Total}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Total de la Venta -->
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding TotalAmount, StringFormat='Total: ${0}'}" 
                                           FontWeight="Bold" FontSize="15" Foreground="Green" 
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

    </Grid>
</UserControl>